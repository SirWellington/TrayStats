<Window x:Class="TrayStats.Views.MqttSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home Assistant MQTT"
        Width="430"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF202020"
        Foreground="#FFF0F0F0">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Send TrayStats sensors to Home Assistant"
                       FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,0" Foreground="#FFB8B8B8" TextWrapping="Wrap"
                       Text="Enter the private MQTT broker address and credentials. The password is stored encrypted for this Windows account."/>
            <TextBlock Margin="0,5,0,0" Foreground="#FF9E9E9E" TextWrapping="Wrap"
                       Text="For another PC, use this broker host's Tailscale name/IP or its LAN address instead of 127.0.0.1."/>
        </StackPanel>

        <CheckBox x:Name="EnabledCheckBox" Grid.Row="1" Margin="0,0,0,12"
                  Content="Publish sensors to Home Assistant"/>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="95"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Broker host" Margin="0,0,0,4"/>
                <TextBox x:Name="HostTextBox" Height="28" Padding="5,3"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Port" Margin="0,0,0,4"/>
                <TextBox x:Name="PortTextBox" Height="28" Padding="5,3"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Home Assistant device name" Margin="0,0,0,4"/>
            <TextBox x:Name="DeviceNameTextBox" Height="28" Padding="5,3"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Username" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameTextBox" Height="28" Padding="5,3"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="Password" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="28" Padding="5,3"/>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="6" Margin="0,4,0,12"
                   Foreground="#FFB8B8B8" TextWrapping="Wrap"/>

        <DockPanel Grid.Row="7" LastChildFill="False">
            <Button x:Name="TestButton" DockPanel.Dock="Left" Width="130" Height="32"
                    Content="Test connection" Click="TestButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="80" Height="32" Margin="0,0,8,0" Content="Cancel" Click="CancelButton_Click"/>
                <Button Width="80" Height="32" Content="Save" IsDefault="True" Click="SaveButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
